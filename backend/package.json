{
  "name": "attendance-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "prisma generate --schema=./prisma/schema.prisma",
    "build": "tsc",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/auth-and-attendance.test.ts tests/email.test.ts tests/forgot-password-flow.test.ts tests/attendance-timer-checkout.test.ts tests/master-data-crud.test.ts tests/attendance-filters.test.ts tests/notifications.test.ts tests/sse-stream-cors.test.ts tests/attendance-date-range-and-shift.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "@prisma/client": "^5.14.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.2",
    "argon2": "^0.40.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
